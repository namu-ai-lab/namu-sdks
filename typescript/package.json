{
  "name": "namu-ai",
  "version": "0.1.0",
  "description": "The Namu API for JavaScript and TypeScript: speech recognition, speech synthesis and translation for Hausa, Zarma and French.",
  "license": "Apache-2.0",
  "author": "Namu AI Lab <contact@namuai.org>",
  "homepage": "https://www.namuai-lab.com/api",
  "keywords": ["namu", "speech", "text-to-speech", "speech-to-text", "translation", "hausa", "zarma", "french", "sahel"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && NAMU_LIVE=1 node --test test/live.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
